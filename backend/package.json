{
  "name": "pexel-remotion-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare Workers backend for the pexel-remotion article-to-video platform",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "gen:html": "node generate-index-html.js",
    "deploy": "node generate-index-html.js && wrangler deploy",
    "db:migrate": "wrangler d1 execute pexel-remotion-db --file=./src/database/schema.sql",
    "db:local": "wrangler d1 execute DB --local --file=./src/database/schema.sql"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "jose": "^5.9.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261117.1",
    "typescript": "^5.6.3",
    "wrangler": "^4.87.0"
  }
}
